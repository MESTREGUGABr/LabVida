# Template de variáveis de ambiente para PRODUÇÃO — LabVida
# Copie para o gestor de segredos do alvo de deploy. NUNCA commite o arquivo real.
# Veja DEPLOY.md para o passo a passo e o checklist de hardening.

# Banco gerenciado (use o host/credenciais do provedor; exija TLS)
DATABASE_URL=postgresql+psycopg://usuario:senha@host-gerenciado:5432/labvida

# Login local (F15). NÃO defina SENHA_PADRAO_SEED em produção — essa variável
# só existe para o seeder de demonstração, que não deve rodar aqui.

# URL pública HTTPS da aplicação
APP_BASE_URL=https://labvida.example.com
PORT=8501

# LGPD — chave Fernet PERMANENTE (não reutilizar a de exemplo; trocar inutiliza CPFs)
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LGPD_ENCRYPTION_KEY=
