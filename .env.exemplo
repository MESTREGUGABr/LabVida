# Host "postgres" = nome do servico na rede interna do Docker Compose.
# Para rodar alembic/streamlit fora do Docker, troque por: @localhost:5432
DATABASE_URL=postgresql+psycopg://labvida:labvida@postgres:5432/labvida
POSTGRES_USER=labvida
POSTGRES_PASSWORD=labvida
POSTGRES_DB=labvida

APP_BASE_URL=http://localhost:8501
PORT=8501

# Seeder da base de demonstracao — janela e volume (ver README secao 9.2).
# SEED_INICIO define a data de inicio da operacao simulada e tem precedencia
# sobre SEED_JANELA_DIAS; com "2022-01-01" a base sai com ~7.5k OS e serie
# temporal do BI de 2022 ate hoje (seed leva de 20 a 60 min).
# SEED_INICIO=2022-01-01
# SEED_JANELA_DIAS=90
# SEED_ESCALA=1.0

# Login local (F15): senha de TODOS os usuarios criados pelo seeder de demo
# (`python -m src.seeder`), inclusive o admin de teste. Opcional — sem essa
# variavel o seeder usa "labvida123". Nunca e lida pelo fluxo de login real;
# so afeta quem o seeder cria. Trocar o valor so tem efeito na PROXIMA
# execucao do seeder (nao redefine senha de usuario ja existente com senha).
SENHA_PADRAO_SEED=labvida123

# LGPD — chave Fernet (32 bytes em base64 url-safe) usada para criptografar o CPF na origem.
# Gere a sua com:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA reutilize esta chave de exemplo em produção (trocar a chave inutiliza os CPFs já gravados).
# O mesmo valor abaixo é usado como fallback de teste em docker-compose.yml
# (serviço app_test) e em tests/conftest.py — é uma chave de exemplo/teste sem
# nenhum dado real por trás.
LGPD_ENCRYPTION_KEY=Q22r1OivohTtSBRaMi-hjLxXxrQ3SwEdOumlaNDfvw8=
